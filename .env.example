NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
TERMII_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional extra salt for hashing applicant IPs (rate limiting on /apply)
IP_HASH_SALT=

# Career Discovery narrative (server-only). Provider lives in lib/career/ai.ts.
GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash)
GEMINI_MODEL=
# Set to 1 in development to log the exact payload sent to the AI (no identifiers)
CAREER_DEBUG_LOG=

# Bank-transfer details shown on the sponsor dashboard (public values)
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
